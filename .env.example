# ============================================================
# ENVIRONMENT VARIABLES — EXAMPLE FILE
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets
# to version control. Add .env.local to .gitignore now if it
# is not already there.
#
# For production, inject variables via your hosting provider's
# secret manager (e.g. Vercel Environment Variables, AWS SSM,
# Doppler) rather than shipping a .env file to the server.
# ============================================================

# ------------------------------------------------------------------
# Convex deployment URL
#
# Format  : https://<deployment-slug>.convex.cloud
# Where   : Convex dashboard → your project → Settings → URL & Deploy Key
# Safety  : This URL is public (it is embedded in the JS bundle).
#           It does not need to be kept secret, but it should match
#           the intended deployment (dev vs. prod).
# ------------------------------------------------------------------
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ------------------------------------------------------------------
# Clerk publishable key
#
# Format  : pk_test_... (development) | pk_live_... (production)
# Where   : Clerk dashboard → your application → API Keys
# Safety  : Publishable keys are intentionally public and are safe to
#           embed in the frontend bundle. They cannot be used to issue
#           tokens or access admin APIs.
# ------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------
# Clerk secret key  ⚠️  SECRET — keep out of version control
#
# Format  : sk_test_... (development) | sk_live_... (production)
# Where   : Clerk dashboard → your application → API Keys
# Safety  : This key grants full administrative access to your Clerk
#           tenant (create/delete users, issue sessions, etc.).
#           - NEVER expose it in client-side code or VITE_* variables.
#           - NEVER log it or include it in error messages.
#           - Rotate immediately at https://dashboard.clerk.com if
#             you suspect it has been leaked.
#           - In production, store it in a secrets manager and inject
#             it as an environment variable at deploy time.
# ------------------------------------------------------------------
CLERK_SECRET_KEY=sk_test_...

# ------------------------------------------------------------------
# Clerk webhook signing secret  ⚠️  SECRET — keep out of version control
#
# Format  : whsec_<base64-string>
# Where   : Clerk dashboard → Webhooks → your endpoint → Signing Secret
# Safety  : This secret is used by convex/http.ts (via the svix library)
#           to verify that incoming webhook payloads were sent by Clerk
#           and have not been tampered with. If this value is missing or
#           wrong, all webhooks will be rejected with 400.
#           - Create a separate webhook endpoint and secret for each
#             environment (dev / staging / prod).
#           - Rotate at https://dashboard.clerk.com/webhooks if leaked.
# ------------------------------------------------------------------
CLERK_WEBHOOK_SECRET=whsec_...
